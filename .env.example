NEXT_PUBLIC_APP_NAME=FUUUD
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Amazon Bedrock Configuration
# Get your bearer token from AWS Bedrock console
AWS_BEARER_TOKEN_BEDROCK=your-bearer-token-here

# AWS region where your Bedrock model is deployed (e.g., us-east-1, us-west-2)
AWS_REGION=us-east-1

# Bedrock model ID (e.g., anthropic.claude-3-5-sonnet-20241022-v2:0)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
